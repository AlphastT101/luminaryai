# Discord
DISCORD_TOKEN=
BOT_NAME=LuminaryAI
BOT_PREFIX=ai.
SHARD_COUNT=1

# Command types (true/false)
ENABLE_PREFIX_COMMANDS=true
ENABLE_SLASH_COMMANDS=true

# Pollinations AI (image generation)
POLLINATIONS_TOKEN=your_pollinations_token_here

# Embed colors (hex, with or without 0x prefix)
EMBED_COLOR_DEFAULT=0x708090
EMBED_COLOR_ERROR=0xFF0000
EMBED_COLOR_SUCCESS=0x00FF00
EMBED_COLOR_WARNING=0xFFA500
EMBED_COLOR_PROCESSING=0x99CCFF
EMBED_COLOR_CONFIRMATION=0xC8DC6C

# Channel / guild IDs (optional; leave empty to disable)
GUILD_LOG_CHANNEL_ID=
ERROR_LOG_CHANNEL_ID=
WELCOME_GUILD_ID=
WELCOME_CHANNEL_ID=

# Links used in embeds
SUPPORT_SERVER_URL=
WEBSITE_URL=https://lumixcore.com
BOT_INVITE_URL=&permissions=8&scope=bot
OWNER_NAME=AlphasT101
OWNER_URL=https://me.lumixcore.com
